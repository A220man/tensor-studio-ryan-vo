# Tensor Studio — Plugin Marketplace
# Copy to .env and fill in real values. Never commit .env.

# Application
DEBUG=false

# Database
DATABASE_URL=sqlite:///./data/marketplace.db

# CORS — frontend origin(s)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keycloak / OIDC (for future auth phase)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# LLM provider settings (opt-in advisory explanations)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=